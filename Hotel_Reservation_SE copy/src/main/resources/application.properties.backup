# Application Configuration
spring.application.name=hotel-reservation-system
server.port=8080

# Database Configuration - Try MySQL first, fallback to H2
# Uncomment the MySQL section when MySQL is properly configured
# Comment out the H2 section when MySQL is working

# MySQL Database Configuration (Uncomment when MySQL is ready)
# spring.datasource.url=jdbc:mysql://localhost:3306/hotel_reservation_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
